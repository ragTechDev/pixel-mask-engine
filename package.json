{
  "name": "@ragtechdev/pixel-mask-engine",
  "version": "0.4.0",
  "description": "Compose and render pixel-art avatars and tiles from fixed masks and palettes.",
  "author": "Natasha Ann",
  "license": "(MIT AND CC-BY-4.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ragTechDev/pixel-mask-engine.git"
  },
  "bugs": {
    "url": "https://github.com/ragTechDev/pixel-mask-engine/issues"
  },
  "homepage": "https://github.com/ragTechDev/pixel-mask-engine#readme",
  "keywords": [
    "pixel-art",
    "avatar",
    "sprite",
    "canvas",
    "svg",
    "tiles"
  ],
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-ART.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./canvas": {
      "types": "./dist/canvas.d.ts",
      "import": "./dist/canvas.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "dev": "vite examples/react-demo",
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json",
    "test": "tsup && node --test test/*.test.mjs",
    "size": "node scripts/size.mjs",
    "changelog": "node scripts/changelog.mjs",
    "changelog:write": "node scripts/changelog.mjs --write",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
